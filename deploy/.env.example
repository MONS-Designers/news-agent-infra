# Deploy this file as `.env` in news-agent's working directory on the server
# (next to newsagent.db) — chmod 600, never commit the filled-in version.
# Names verified against news-agent@dev's src/newsagent/config.py (2026-08-12).

# --- NEWSAGENT_-prefixed settings ---
# NOTE: this file is deployed as a systemd EnvironmentFile (see deploy/provision-vm.sh /
# newsagent-api.service). systemd only treats a line as a comment when `#` is the FIRST
# character — an inline `KEY=value  # comment` is NOT stripped and becomes part of the value.
# Keep all comments on their own line, never inline.
# news-agent@dev switched its default from SQLite to Postgres (commit b81b1eb).
# Real value lives in news-agent's local .env — this placeholder is never used as-is.
NEWSAGENT_DATABASE_URL=

# mock | external
NEWSAGENT_LLM_PROVIDER=
# Optional instructions for the Hebrew article translation/summary prompt.
# The response JSON schema remains fixed in the application.
NEWSAGENT_SUMMARY_PROMPT=
# popularity | llm
NEWSAGENT_SUGGESTION_PROVIDER=

# console | smtp
NEWSAGENT_EMAIL_SENDER=smtp
NEWSAGENT_SMTP_HOST=smtp.gmail.com
NEWSAGENT_SMTP_PORT=587
NEWSAGENT_SMTP_USERNAME=newsagent.ai.01@gmail.com
# Gmail App Password, not the account password
NEWSAGENT_SMTP_PASSWORD=
NEWSAGENT_SMTP_FROM_ADDRESS=newsagent.ai.01@gmail.com
NEWSAGENT_SMTP_USE_TLS=true

NEWSAGENT_MAX_USERS=10

NEWSAGENT_GOOGLE_CLIENT_ID=
NEWSAGENT_GOOGLE_CLIENT_SECRET=
# long random string, e.g. `openssl rand -hex 32`
NEWSAGENT_SESSION_SECRET=
# Requires PR #47 (CORS + session_cookie_domain) merged — leading dot shares
# the cookie across both subdomains below. Leave empty for a single-domain deploy.
NEWSAGENT_SESSION_COOKIE_DOMAIN=.REPLACE_WITH_DOMAIN

NEWSAGENT_FRONTEND_URL=https://app.REPLACE_WITH_DOMAIN
NEWSAGENT_BACKEND_BASE_URL=https://api.REPLACE_WITH_DOMAIN

# --- NOT prefixed (pydantic aliases in config.py — verified, don't add NEWSAGENT_) ---
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_AUTH_TOKEN=
EXTERNAL_LLM_MODEL=

LOCAL_LLM_BASE_URL=
LOCAL_LLM_AUTH_TOKEN=
LOCAL_LLM_MODEL=
